# ======================================================================
# AhBiYout IpName2 - Official .gitignore
# ======================================================================

# Dependencies
node_modules/
bun.lock

# Build & Distribution Artifacts
dist/
dist-ssr/
dist-installer/
build/
Output/
release/
*.local
*.zip
*.tar.gz
*.7z

# Tauri & Rust Compilation Cache
src-tauri/target/
src-tauri/Cargo.lock

# Binaries & Executables (Installers published via GitHub Releases only)
*.exe
*.msi
*.dll
*.lib
*.exp
*.pdb
*.obj
*.o
*.so
*.dylib
*.bundle

# Preserve source files while ignoring compilation outputs in native directory
native/ipname_core/*.dll
native/ipname_core/*.lib
native/ipname_core/*.exp
native/ipname_core/*.obj
native/ipname_core/*.o

# Environment Variables & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS & Filesystem Metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
