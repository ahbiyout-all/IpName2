# ======================================================================
# AhBiYout IpName2 - Official .gitignore
# ======================================================================

# AI Studio Internal Data & Scratch Artifacts
.aistudio/
.aistudio

# Dependencies & Package Manager Locks
node_modules/
bun.lock
package-lock.json.backup

# Build & Distribution Artifacts
dist/
dist-ssr/
dist-installer/
build/
Output/
release/
target/
*.local
*.zip
*.tar.gz
*.7z
*.rar
*.gz
*.cab
*.iso
*.dmg
*.app
*.apk
*.ipa
*.aab

# Tauri & Rust Compilation Cache
src-tauri/target/
src-tauri/Cargo.lock

# Binaries & Executables (Binaries are distributed via GitHub Releases)
*.exe
*.msi
*.dll
*.lib
*.exp
*.pdb
*.obj
*.o
*.a
*.so
*.dylib
*.bundle

# Preserve source files while ignoring compilation outputs in native directory
native/ipname_core/*.dll
native/ipname_core/*.lib
native/ipname_core/*.exp
native/ipname_core/*.obj
native/ipname_core/*.o
native/ipname_core/*.a

# Neutralino legacy binaries
bin/neutralino*

# Environment Variables & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.claude/
.cursor/
*.suo
*.user
*.userosv
*.sln.docstates
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# OS & Filesystem Metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.cache
*.tsbuildinfo
coverage/
*.stackdump
crash.dmp
dump.rdb

# One-off scratch scripts & artifacts
icon_base64.txt
convert.cjs
extract-png.cjs
get-b64.cjs
make-icon.cjs
make-strict-ico.cjs
fix-icon.js
download-icons.ts
download-official-icons.js

# Local Git push automation scripts (excluded from GitHub repository)
git-push.bat
scripts/git-push.bat

