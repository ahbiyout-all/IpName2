{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "project": "IpName2",
  "version": "1.12.4",
  "description": "Whitelist manifest of core files required to build, test, and package IpName2 for GitHub repository sync",
  "coreDirectories": [
    ".github/workflows",
    "bin",
    "docs",
    "installer",
    "native/ipname_core",
    "native/ipname_core/include",
    "native/ipname_core/src",
    "public",
    "scripts",
    "scripts/github",
    "src",
    "src/components",
    "src/contexts",
    "src/hooks",
    "src/i18n",
    "src/lib",
    "src-tauri/capabilities",
    "src-tauri/icons",
    "src-tauri/src"
  ],
  "coreRootFiles": [
    ".env.example",
    ".gitignore",
    ".gitkeep-ignore",
    "AGENTS.md",
    "app-icon.png",
    "build.bat",
    "build.ps1",
    "fix-icon.cjs",
    "index.html",
    "IpName2.ico",
    "IpName2.png",
    "metadata.json",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "requiredFiles": [
    "package.json",
    "vite.config.ts",
    "tsconfig.json",
    "index.html",
    "fix-icon.cjs",
    "build.bat",
    "installer/setup.iss",
    ".github/workflows/release.yml",
    "bin/postbuild-rename.cjs",
    "native/ipname_core/src/ipname_core.c",
    "native/ipname_core/include/ipname_core.h",
    "native/ipname_core/build.bat",
    "src-tauri/Cargo.toml",
    "src-tauri/tauri.conf.json",
    "src-tauri/build.rs",
    "src-tauri/src/main.rs",
    "src-tauri/src/lib.rs",
    "src-tauri/src/windows_native.rs",
    "src/App.tsx",
    "src/main.tsx",
    "src/index.css",
    "src/types.ts",
    "docs/README.md",
    "docs/ARCHITECTURE.md",
    "docs/DEVELOPMENT.md",
    "docs/DLL_SPECIFICATION.md",
    "docs/PATCH_NOTES.md",
    "docs/ROADMAP.md",
    "docs/LICENSE_NOTICE.md",
    "docs/VERSIONING_POLICY.md"
  ],
  "excludedFiles": [
    "git-push.bat",
    "scripts/git-push.bat"
  ],
  "prohibitedPatterns": [
    ".aistudio*",
    "bin/neutralino*",
    "*.apk",
    "*.ipa",
    "*.aab",
    "bun.lock",
    "*.log",
    "*.tmp",
    "*.bak",
    "convert.cjs",
    "extract-png.cjs",
    "download-icons.ts",
    "download-official-icons.js",
    "fix-icon.js",
    "get-b64.cjs",
    "icon_base64.txt",
    "make-icon.cjs",
    "make-strict-ico.cjs"
  ]
}
