{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IpName2 v1.10.0",
  "version": "1.10.0",
  "identifier": "com.ipname2.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node fix-icon.cjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IpName2 v1.10.0",
        "width": 650,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "Copyright © 2026 AhBiYout. All rights reserved.",
    "publisher": "AhBiYout",
    "shortDescription": "IpName2 - Windows System & Network Configuration Utility",
    "longDescription": "IpName2 is an advanced Windows desktop utility designed for managing computer names, workgroups, IP addresses, subnets, gateways, DNS servers, and NIC adapters with native Win32 performance.",
    "homepage": "https://ahbiyoutvibe.blogspot.com/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"]
      }
    }
  }
}
